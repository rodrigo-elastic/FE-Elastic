ANTHROPIC_API_KEY=sk-ant-replace-me

# Default model used by every agent. Cheapest by default; override per-agent below.
# Options: claude-haiku-4-5 (cheap), claude-sonnet-4-6 (balanced), claude-opus-4-7 (most capable).
MODEL_DEFAULT=claude-haiku-4-5

# Per-agent overrides (leave empty to fall back to MODEL_DEFAULT).
MODEL_PRE_MEETING=
MODEL_POST_MEETING=
MODEL_LIVE_MEETING=

ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=
KIBANA_URL=http://localhost:5601
# Kibana API key for /api/agent_builder/* (Enterprise required). Leave empty for dry-run mode.
KIBANA_API_KEY=
APP_HOST=0.0.0.0
APP_PORT=8123
APP_ENV=development
LOG_LEVEL=INFO
RUNTIME_DIR=./runtime
